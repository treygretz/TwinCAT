<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAIN" Id="{eb436a36-c8e2-4fab-9b6a-b8a59b9af6d9}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
    fbEnc : FB_SimEncoder;
    bGo   : BOOL;  // Wire to a HMI button or PLC tag
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[fbEnc(
    bActivate := bGo,
    rSpeed    := 1000.0,   // 1000 counts/s
    bDirection:= TRUE,
    nResolution := 4096    // e.g. 4096 PPR encoder
);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>